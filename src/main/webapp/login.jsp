<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Student Login | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav><div class="brand">⚡ CODEQUEST</div><div class="navlinks"><a href="index.html">Home</a><a href="register.jsp">Register</a></div></nav><main class="page"><div class="panel form-card"><h1>Welcome Back 👋</h1><p class="subtitle">Login and continue your coding adventure.</p><% if(request.getParameter("success")!=null){ %><div class="message"><%=request.getParameter("success")%></div><% } %><% if(request.getAttribute("message")!=null){ %><div class="message error"><%=request.getAttribute("message")%></div><% } %><form action="login" method="post"><div class="field"><label>Username or Email</label><input name="login" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn primary wide">Login to Quest →</button></form></div></main></body></html>