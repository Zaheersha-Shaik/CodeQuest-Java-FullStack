<%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("adminId")==null){response.sendRedirect("admin-login.jsp");return;} %><!DOCTYPE html><html><head><title>Add Mission</title><link rel="stylesheet" href="css/style.css"></head><body><nav><div class="brand">⚡ CODEQUEST ADMIN</div><div class="navlinks"><a href="admin-dashboard.jsp">Dashboard</a><a href="view-questions">Questions</a></div></nav><main class="page"><div class="panel form-card" style="max-width:850px"><h1>Create New Mission ➕</h1><% if(request.getParameter("success")!=null){%><div class="message"><%=request.getParameter("success")%></div><%}%><% if(request.getAttribute("message")!=null){%><div class="message error"><%=request.getAttribute("message")%></div><%}%><form action="add-question" method="post"><div class="field"><label>Question Title</label><input name="title" required></div><div class="field"><label>Description</label><textarea name="description" required></textarea></div><div class="two-col"><div class="field"><label>Category</label><select name="category"><option>Java</option><option>SQL</option><option>DSA</option></select></div><div class="field"><label>Difficulty</label><select name="difficulty"><option>Easy</option><option>Medium</option><option>Hard</option></select></div></div><div class="two-col"><div class="field"><label>Option 1</label><input name="option1" required></div><div class="field"><label>Option 2</label><input name="option2" required></div><div class="field"><label>Option 3</label><input name="option3" required></div><div class="field"><label>Option 4</label><input name="option4" required></div></div><div class="two-col"><div class="field"><label>Correct Answer (exact option text)</label><input name="correctAnswer" required></div><div class="field"><label>XP Reward</label><input type="number" name="xpReward" value="20" min="1" required></div></div><button class="btn primary wide">Save Mission ⚡</button></form></div></main></body></html>