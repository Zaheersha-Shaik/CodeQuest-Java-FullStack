<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.codequest.util.DBConnection,java.sql.*" %><!DOCTYPE html><html><head><title>Leaderboard | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav><div class="brand">⚡ CODEQUEST</div><div class="navlinks"><a href="index.html">Home</a><a href="missions">Missions</a><a href="dashboard">Dashboard</a></div></nav><main class="page"><h1>Global Leaderboard 🏆</h1><p class="subtitle">The strongest CodeQuest players ranked by total XP.</p><table><tr><th>Rank</th><th>Player</th><th>Level</th><th>Completed Missions</th><th>Total XP</th></tr><%int rank=0;try(Connection c=DBConnection.getConnection();PreparedStatement ps=c.prepareStatement("SELECT u.username,u.level,u.xp,(SELECT COUNT(*) FROM mission_submissions ms WHERE ms.user_id=u.id AND ms.is_correct=TRUE) completed FROM users u ORDER BY u.xp DESC,u.username");ResultSet rs=ps.executeQuery()){while(rs.next()){rank++;String medal=rank==1?"🥇":rank==2?"🥈":rank==3?"🥉":"#"+rank;%><tr><td><%=medal%></td><td><%=rs.getString("username")%></td><td><%=rs.getInt("level")%></td><td><%=rs.getInt("completed")%></td><td>⚡ <%=rs.getInt("xp")%></td></tr><%}if(rank==0){%><tr><td colspan="5">No players available yet. Be the first to join the quest!</td></tr><%}}catch(Exception e){%><tr><td colspan="5">Database error: <%=e.getMessage()%></td></tr><%}%></table></main></body></html>