<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.codequest.model.Mission" %><% if(session.getAttribute("adminId")==null){response.sendRedirect("admin-login.jsp");return;} List<Mission> missions=(List<Mission>)request.getAttribute("missions"); %><!DOCTYPE html><html><head><title>Manage Missions</title><link rel="stylesheet" href="css/style.css"></head><body><nav><div class="brand">⚡ CODEQUEST ADMIN</div><div class="navlinks"><a href="admin-dashboard.jsp">Dashboard</a><a href="add-question.jsp">Add Mission</a></div></nav><main class="page"><h1>All Programming Missions 📋</h1><% if(request.getAttribute("message")!=null){%><div class="message error"><%=request.getAttribute("message")%></div><%}%><table><tr><th>ID</th><th>Title</th><th>Category</th><th>Difficulty</th><th>XP Reward</th></tr><% if(missions!=null&&missions.size()>0){for(Mission m:missions){%><tr><td>#<%=m.getId()%></td><td><%=m.getTitle()%></td><td><%=m.getCategory()%></td><td><%=m.getDifficulty()%></td><td>⚡ <%=m.getXpReward()%></td></tr><%}}else{%><tr><td colspan="5">No missions available.</td></tr><%}%></table></main></body></html>