<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.codequest.model.Mission" %><% List<Mission> missions=(List<Mission>)request.getAttribute("missions");boolean logged=session.getAttribute("userId")!=null; %><!DOCTYPE html><html><head><title>Missions | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav><div class="brand">⚡ CODEQUEST</div><div class="navlinks"><a href="index.html">Home</a><%if(logged){%><a href="dashboard">Dashboard</a><a href="logout">Logout</a><%}else{%><a href="login.jsp">Login</a><%}%><a href="leaderboard.jsp">Leaderboard</a></div></nav><main class="page"><h1>Programming Missions 🎯</h1><p class="subtitle">Choose your answer carefully. Every mission allows only one attempt.</p><%if(request.getAttribute("message")!=null){%><div class="message error"><%=request.getAttribute("message")%></div><%}%><%if(missions!=null){for(Mission m:missions){%><div class="panel mission"><div class="badges"><span class="badge"><%=m.getCategory()%></span><span class="badge"><%=m.getDifficulty()%></span><span class="badge">⚡ <%=m.getXpReward()%> XP</span></div><h2><%=m.getTitle()%></h2><p class="subtitle"><%=m.getDescription()%></p><%if(logged){%><form action="submit-answer" method="post"><input type="hidden" name="missionId" value="<%=m.getId()%>"><label class="option"><input type="radio" name="answer" value="<%=m.getOption1()%>" required> <%=m.getOption1()%></label><label class="option"><input type="radio" name="answer" value="<%=m.getOption2()%>"> <%=m.getOption2()%></label><label class="option"><input type="radio" name="answer" value="<%=m.getOption3()%>"> <%=m.getOption3()%></label><label class="option"><input type="radio" name="answer" value="<%=m.getOption4()%>"> <%=m.getOption4()%></label><button class="btn primary">Submit Answer ⚡</button></form><%}else{%><a class="btn primary" href="login.jsp">Login to Attempt →</a><%}%></div><%}}%></main></body></html>